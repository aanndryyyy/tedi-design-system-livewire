# /.storybook used to be ignored as generated output. It is now project-owned
# config (published with `php artisan blast:publish-storybook-config`) and
# carries the docs inline-rendering fix, so it has to be committed.
/node_modules
/public/blast
/public/vendor
/public/storybook-static
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/vendor
.env
.phpunit.result.cache
/bootstrap/cache/*

# Last match wins, so this has to stay below every rule above: the directories
# themselves must exist in a fresh clone. `composer install` runs
# `artisan package:discover`, which aborts if bootstrap/cache is missing.
!.gitkeep
