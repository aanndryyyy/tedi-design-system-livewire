APP_NAME="TEDI Storybook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Storybook Server renders every story over HTTP against this URL, so it has to
# match the host and port the app is actually served on. start.sh reads it.
APP_URL=http://127.0.0.1:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
