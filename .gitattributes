# Keep the development apparatus out of the Composer package. Consumers get
# src/, resources/, config/, lang/ and dist/ only.
/.github            export-ignore
/.reference         export-ignore
/storybook          export-ignore
/tests              export-ignore
/workbench          export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CONVENTIONS.md     export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpunit.xml        export-ignore
/testbench.yaml     export-ignore

*.blade.php linguist-language=Blade
