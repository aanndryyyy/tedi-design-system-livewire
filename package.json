{
  "name": "@tedi-design-system/livewire-build",
  "private": true,
  "description": "Stylesheet build pipeline for tedi-design-system/livewire",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:fonts",
    "build:css": "sass --load-path=node_modules --no-source-map --style=compressed resources/scss/index.scss dist/tedi.css && replace-in-file \"//fonts//g\" \"./fonts/\" dist/tedi.css --isRegex",
    "build:fonts": "mkdir -p dist/fonts && cp -a node_modules/@tedi-design-system/core/fonts/* dist/fonts/",
    "watch": "sass --load-path=node_modules --watch resources/scss/index.scss dist/tedi.css",
    "build:js": "mkdir -p dist && cp resources/js/tedi.js dist/tedi.js"
  },
  "devDependencies": {
    "@tedi-design-system/core": "^6.5.0",
    "replace-in-file": "^8.4.0",
    "sass": "^1.101.0"
  }
}
