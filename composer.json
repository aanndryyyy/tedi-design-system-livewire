{
    "name": "aanndryyyy/tedi-design-system-livewire",
    "description": "TEDI Design System components for Laravel Blade and Livewire",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "blade", "tedi", "design-system", "tehik"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "require-dev": {
        "livewire/livewire": "^4.3",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tedi\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tedi\\Livewire\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tedi\\Livewire\\TediServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
